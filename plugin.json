{
  "id": "kugou-lite",
  "name": "Kugou Concept",
  "version": "1.4.1",
  "minAppVersion": "0.1.20",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "gateway.kugou.com",
      "openapi.kugou.com",
      "login-user.kugou.com",
      "lyrics.kugou.com",
      "krcs.kugou.com",
      "kugouvip.kugou.com",
      "userservice.kugou.com",
      "mcloudservice.kugou.com",
      "listenservice.kugou.com"
    ]
  },
  "settings": [
    {
      "key": "platform",
      "label": "Protocol",
      "type": "select",
      "help": "Concept Edition (default) gets the daily free VIP. Kugou Music uses the VIP bought in the regular Kugou app.",
      "options": [
        {
          "value": "",
          "label": "Kugou Concept (default)"
        },
        {
          "value": "standard",
          "label": "Kugou Music"
        }
      ]
    },
    {
      "key": "autoVip",
      "label": "Daily free VIP",
      "type": "select",
      "help": "Claims the Concept Edition's free VIP once a day while signed in.",
      "options": [
        {
          "value": "",
          "label": "On (default)"
        },
        {
          "value": "0",
          "label": "Off"
        }
      ]
    }
  ],
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "title": "Daily picks",
      "page": "daily",
      "icon": "calendar"
    },
    {
      "title": "Discover",
      "page": "discover",
      "icon": "note"
    },
    {
      "title": "Charts",
      "page": "charts",
      "icon": "chart"
    },
    {
      "title": "Audiobooks",
      "page": "audiobooks",
      "icon": "podcast"
    },
    {
      "title": "Private FM",
      "builtin": "stations"
    },
    {
      "builtin": "liked"
    },
    {
      "title": "Recently played",
      "page": "recent",
      "icon": "star"
    },
    {
      "title": "Music cloud",
      "page": "cloud",
      "icon": "playlist"
    }
  ]
}
